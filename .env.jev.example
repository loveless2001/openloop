# Append these evaluator-only settings to the existing .env file. Do not replace completion or
# critic settings. TYPESAFE_API_KEY is server-only and must never be exposed to the browser.
EVALUATOR_PROVIDER=typesafe
TYPESAFE_API_KEY=
JEV_API_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=30000
