NODE_ENV=development
WEB_PORT=5173
SERVER_PORT=8787
DATABASE_URL=file:./data/openloop.db

# Fast autocomplete runs locally. Install the configured model with: pnpm setup:ollama
COMPLETION_PROVIDER=ollama
COMPLETION_BASE_URL=http://127.0.0.1:11434/v1
COMPLETION_API_KEY=
COMPLETION_MODEL=qwen2.5:0.5b
COMPLETION_KEEP_ALIVE=30m

# The slower critic is independently configurable. Use cli-agent for the managed MCP worker.
CRITIC_PROVIDER=mock
CRITIC_BASE_URL=http://127.0.0.1:11434/v1
CRITIC_API_KEY=
CRITIC_MODEL=gpt-5.6-terra
CRITIC_SUPPORTS_JSON_SCHEMA=false

# Linux-only managed CLI terminal. Authentication remains owned by the CLI.
CRITIC_AGENT=codex
CRITIC_AGENT_COMMAND=
CRITIC_AGENT_JOB_TIMEOUT_MS=300000

# Opt in to raw local completion traces for offline training. These contain document text.
CAPTURE_TRAINING_TRACES=false
TRAINING_TRACE_PATH=data/training/completion-traces.jsonl

LOG_MODEL_CONTENT=false
LOG_DOCUMENT_CONTENT=false
